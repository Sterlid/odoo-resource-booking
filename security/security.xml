<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="group_booking_user" model="res.groups">
        <field name="name">Booking User</field>
    </record>
    <record id="group_booking_admin" model="res.groups">
        <field name="name">Booking Admin</field>
    </record>

    <record id="booking_rule_user_own" model="ir.rule">
        <field name="name">Booking Users: own bookings</field>
        <field name="model_id" ref="model_booking_booking" />
        <field name="groups" eval="[(4, ref('booking.group_booking_user'))]" />
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>
    <record id="booking_rule_admin_all" model="ir.rule">
        <field name="name">Booking Admins: all bookings</field>
        <field name="model_id" ref="model_booking_booking" />
        <field name="groups" eval="[(4, ref('booking.group_booking_admin'))]" />
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>

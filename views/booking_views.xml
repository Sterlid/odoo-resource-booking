<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="booking_view_list" model="ir.ui.view">
        <field name="name">booking.booking.list</field>
        <field name="model">booking.booking</field>
        <field name="arch" type="xml">
            <list string="Bookings">
                <field name="name" />
                <field name="resource_id" />
                <field name="user_id" />
                <field name="booking_date" />
                <field name="time_slot" />
                <field name="approval_status" />
            </list>
        </field>
    </record>
    <record id="booking_view_form" model="ir.ui.view">
        <field name="name">booking.booking.form</field>
        <field name="model">booking.booking</field>
        <field name="arch" type="xml">
            <form string="Booking">
                <header>
                    <button name="action_approve" type="object" string="Approve"
                        class="oe_highlight" groups="booking.group_booking_admin"
                        invisible="not id or approval_status != 'pending_approval'" />
                    <button name="action_cancel" type="object" string="Cancel Booking"
                        confirm="Cancel this booking and release the reserved time?"
                        invisible="not id or not can_cancel" />
                    <field name="approval_status" widget="statusbar" readonly="1"
                        statusbar_visible="pending_approval,confirmed" />
                </header>
                <sheet>
                    <group>
                        <field name="resource_id"
                            readonly="approval_status == 'confirmed'"
                            options="{'no_create': True, 'no_create_edit': True}" />
                        <field name="booking_date" required="1" readonly="approval_status == 'confirmed'" />
                        <field name="time_slot" required="1" readonly="approval_status == 'confirmed'" />
                        <!-- <field name="name" readonly="not booking_rights" /> -->
                        <field name="booking_rights" invisible="1" />
                        <field name="can_cancel" invisible="1" />
                        <field name="start_datetime" invisible="1" />
                        <field name="end_datetime" invisible="1" />
                        <field name="user_id" readonly="not booking_rights" />
                        <field name="calendar_id" readonly="1" />
                        <field name="additional_notes" />
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>


    <record id="booking_view_search" model="ir.ui.view">
        <field name="name">booking.booking.search</field>
        <field name="model">booking.booking</field>
        <field name="arch" type="xml">
            <search string="Bookings">
                <field name="name" />
                <field name="resource_id" />
                <field name="user_id" />
                <field name="booking_date" />
                <field name="approval_status" />
                <filter name="pending_approval" string="Pending Approval"
                    domain="[('approval_status', '=', 'pending_approval')]" />
            </search>
        </field>
    </record>

    <record id="booking_booking_action" model="ir.actions.act_window">
        <field name="name">All Bookings</field>
        <field name="res_model">booking.booking</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="search_view_id" ref="booking_view_search" />
    </record>
    <record id="booking_my_bookings_action" model="ir.actions.act_window">
        <field name="name">My Bookings</field>
        <field name="res_model">booking.booking</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('user_id', '=', uid)]</field>
        <field name="search_view_id" ref="booking_view_search" />
    </record>
</odoo>

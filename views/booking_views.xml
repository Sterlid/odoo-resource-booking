<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="booking_view_list" model="ir.ui.view">
        <field name="name">booking.booking.list</field>
        <field name="model">booking.booking</field>
        <field name="arch" type="xml">
            <list string="Bookings">
                <field name="name" />
                <field name="resource_id" />
                <field name="user_id" />
                <field name="booking_date" />
                <field name="time_slot" />
                <field name="approval_status" />
            </list>
        </field>
    </record>
    <record id="booking_view_form" model="ir.ui.view">
        <field name="name">booking.booking.form</field>
        <field name="model">booking.booking</field>
        <field name="arch" type="xml">
            <form string="Booking">
                <sheet>
                    <group>
                        <field name="resource_id"
                            options="{'no_create': True, 'no_create_edit': True}" />
                        <field name="booking_date" required="1" />
                        <field name="time_slot" required="1" />
                        <!-- <field name="name" readonly="not booking_rights" /> -->
                        <!-- <field name="approval_status" readonly="not booking_rights" /> -->
                        <field name="booking_rights" invisible="1" />
                        <field name="start_datetime" invisible="1" />
                        <field name="end_datetime" invisible="1" />
                        <field name="user_id" />
                        <field name="calendar_id" readonly="1" />
                        <field name="additional_notes" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="booking_booking_action" model="ir.actions.act_window">
        <field name="name">Bookings</field>
        <field name="res_model">booking.booking</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="booking_resource_list" model="ir.ui.view">
        <field name="name">resource.resource.list.booking</field>
        <field name="model">resource.resource</field>
        <field name="arch" type="xml">
            <list string="Bookable Resources">
                <field name="name" />
                <field name="resource_category" />
                <field name="approval_policy" string="Approval Type" />
                <field name="advance_booking_limit" width="280px" />
            </list>
        </field>
    </record>

    <record id="booking_resource_form_inherit" model="ir.ui.view">
        <field name="name">resource.resource.form.booking</field>
        <field name="model">resource.resource</field>
        <field
            name="inherit_id"
            ref="resource.resource_resource_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='resource_type']" position="attributes">
                <attribute name="invisible">context.get('booking_resource_form', False)</attribute>
            </xpath>
            <xpath expr="//field[@name='time_efficiency']" position="attributes">
                <attribute name="invisible">context.get('booking_resource_form', False)</attribute>
            </xpath>
            <xpath expr="//field[@name='calendar_id']" position="attributes">
                <attribute name="string">Booking Hours</attribute>
            </xpath>
            <xpath
                expr="//group[@name='user_details']"
                position="inside"
            >
                <field
                    name="resource_category"
                    invisible="not is_available_for_booking"
                    groups="booking.group_booking_admin"
                />
                <field
                    name="approval_policy"
                    string="Approval Type"
                    invisible="not is_available_for_booking"
                    groups="booking.group_booking_admin"
                />
            </xpath>
            <xpath expr="//group[@name='resource_details']" position="inside">
                <field
                    name="advance_booking_limit"
                    invisible="not is_available_for_booking"
                    groups="booking.group_booking_admin"
                />
            </xpath>
        </field>
    </record>

    <record id="booking_resource_form" model="ir.ui.view">
        <field name="name">resource.resource.form.booking.save.return</field>
        <field name="model">resource.resource</field>
        <field name="inherit_id" ref="resource.resource_resource_form" />
        <field name="mode">primary</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="js_class">booking_save_return_form</attribute>
            </xpath>
        </field>
    </record>

    <record id="booking_resource_action" model="ir.actions.act_window">
        <field name="name">Bookable Resources</field>
        <field name="res_model">resource.resource</field>
        <field name="view_mode">list,form</field>
        <field name="domain">
            [('resource_type', '=', 'material')]
        </field>
        <field name="context">
            {
            'booking_resource_form': True,
            'default_resource_type': 'material',
            'default_is_available_for_booking': True
            }
        </field>
    </record>
    <record id="booking_resource_action_list" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="booking_resource_list" />
        <field name="act_window_id" ref="booking_resource_action" />
    </record>
    <record id="booking_resource_action_form" model="ir.actions.act_window.view">
        <field name="sequence">10</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="booking_resource_form" />
        <field name="act_window_id" ref="booking_resource_action" />
    </record>
</odoo>
